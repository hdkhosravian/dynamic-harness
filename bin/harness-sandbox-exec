#!/usr/bin/python3 -I
"""harness-sandbox-exec [--cwd DIR] [--deny-read DIR]... [--timeout S] -- ARGV...

Runs ARGV (no shell) under the harness sandbox: no network, no Apple Events, no
reads of ${CLAUDE_PLUGIN_DATA}/keys|experience, writes only under the working
directory and a temp dir, never to the workspace's protected paths, and no reads
or writes anywhere under ${CLAUDE_PLUGIN_DATA} (keys, state, lock files).

Inside Claude Code's sandbox (after /dynamic-harness:setup) the native sandbox cannot nest; then the
command runs in the surrounding sandbox once run() has verified it from the inside (``_outer``).

Every path is resolved once (``_resolve``: realpath, then lstat of each component)
and only those resolved paths reach the profile and the child's cwd, so a symlink
swapped in after the checks cannot move a rule.
"""
import glob
import os
import stat
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

PROTECTED = (".git", ".claude", "CLAUDE.md", "CLAUDE.local.md", ".mcp.json")  # under the project root


def _under(p, root):
    p, root = p.casefold(), root.casefold().rstrip(os.sep)  # the default macOS filesystem ignores case
    return p == root or p.startswith(root + os.sep)


def _resolve(p):
    """realpath, then lstat every component: a symlink there means a swap since the resolve."""
    real, cur = os.path.realpath(p), os.sep
    for part in real.split(os.sep)[1:]:
        cur = os.path.join(cur, part)
        try:
            if stat.S_ISLNK(os.lstat(cur).st_mode):
                raise ValueError(f"{cur} became a symlink while resolving {p!r}; refusing to run")
        except FileNotFoundError:
            break  # the rest does not exist yet
    return real


def _job_dirs(project):
    """<project>/.claude/loops/<job>/{work,requests}. Refuses a symlink at any level (lstat), so a write
    exception can never point outside the workspace."""
    claude = os.path.join(project, ".claude")
    loops = os.path.join(claude, "loops")
    for d in (claude, loops):
        if os.path.islink(d):
            raise ValueError(f"{d} is a symlink; refusing to run")
    if not os.path.isdir(loops):
        return []
    out = []
    for job in sorted(os.listdir(loops)):
        jd = os.path.join(loops, job)
        if os.path.islink(jd):
            raise ValueError(f"{jd} is a symlink; refusing to run")
        for n in ("work", "requests"):
            d = os.path.join(jd, n)
            if os.path.islink(d):
                raise ValueError(f"{d} is a symlink; refusing to run")
            if os.path.isdir(d):
                out.append(_resolve(d))
    return out


# protected names inside the project that Claude Code's sandbox (built in, plus setup's CLAUDE*.md
# denyWrite) keeps unwritable; run() verifies each existing one and the guard watches for new ones
OUTER_DENY_WRITE = (".claude/settings.json", ".claude/settings.local.json", ".claude/hooks", ".claude/commands",
                    ".claude/agents", ".claude/skills", ".mcp.json", ".git/hooks", ".git/config",
                    "CLAUDE.md", "CLAUDE.local.md")


def _project_of(real_cwd):
    """CLAUDE_PROJECT_DIR when set, else the nearest ancestor with .git or .claude, else the cwd."""
    env = os.environ.get("CLAUDE_PROJECT_DIR")
    if env:
        return _resolve(env)
    d = real_cwd
    while True:
        if any(os.path.lexists(os.path.join(d, n)) for n in (".git", ".claude")):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            return real_cwd
        d = parent


def _outer(sandbox_exec, cmd, cwd, deny_read, timeout):
    """Inside Claude Code's sandbox the native one cannot nest. The Bash tool's environment has no
    CLAUDE_* variables (live check), so the project comes from CLAUDE_PROJECT_DIR or the nearest .git /
    .claude ancestor. run() itself verifies, from the inside, that the surrounding sandbox keeps every
    plugin's keys unreadable, the network off, the data roots and the protected names unwritable, and
    every --deny-read unreadable; it refuses otherwise."""
    from harness_core.errors import HarnessError

    try:
        real_cwd = _resolve(cwd)
        claude_home = _resolve(os.path.join(sandbox_exec._real_home(), ".claude"))
        project = _project_of(real_cwd)
        jobs = _job_dirs(project)
    except ValueError as e:
        print(f"harness-sandbox-exec: {e}", file=sys.stderr)
        return 2
    if _under(real_cwd, claude_home):
        print(f"harness-sandbox-exec: --cwd {cwd!r} is inside {claude_home}; refusing to run", file=sys.stderr)
        return 2
    protected = [os.path.join(project, n) for n in PROTECTED]
    if any(_under(real_cwd, p) for p in protected) and not any(_under(real_cwd, j) for j in jobs):
        print(f"harness-sandbox-exec: --cwd {cwd!r} is inside a protected workspace path; refusing to run", file=sys.stderr)
        return 2
    deny_write = [os.path.join(project, n) for n in OUTER_DENY_WRITE]
    deny_write += glob.glob(os.path.join(project, "**", "CLAUDE*.md"), recursive=True)
    stdin = None if sys.stdin is None or sys.stdin.isatty() else sys.stdin.buffer.read()
    try:
        code, out, err = sandbox_exec.run(cmd, real_cwd, stdin, timeout, deny_read=[_resolve(d) for d in deny_read],
                                          deny_write=deny_write, watch=[project])
    except HarnessError as e:
        print(f"harness-sandbox-exec: {e}", file=sys.stderr)
        return 2
    sys.stdout.buffer.write(out)
    sys.stderr.buffer.write(err)
    return code


def main(argv):
    from harness_core import sandbox_exec

    cwd, deny_read, timeout, i = os.getcwd(), [], 600, 0
    while i < len(argv) and argv[i] != "--":
        if argv[i] in ("--cwd", "--deny-read", "--timeout") and i + 1 < len(argv):
            if argv[i] == "--cwd":
                cwd = argv[i + 1]
            elif argv[i] == "--deny-read":
                deny_read.append(argv[i + 1])
            else:
                timeout = float(argv[i + 1])
            i += 2
            continue
        break
    cmd = argv[i + 1:] if i < len(argv) and argv[i] == "--" else argv[i:]
    if not cmd:
        print(__doc__, file=sys.stderr)
        return 2
    b = sandbox_exec.backend()
    if b is not None and sandbox_exec._native_ok(b) == "nested":
        return _outer(sandbox_exec, cmd, cwd, deny_read, timeout)
    data = os.environ.get("CLAUDE_PLUGIN_DATA")
    if not data:
        # fail closed: without the data root we cannot deny its keys/
        print("harness-sandbox-exec: CLAUDE_PLUGIN_DATA is not set; refusing to run", file=sys.stderr)
        return 2
    home = _resolve(os.path.expanduser("~"))
    claude_home = _resolve(os.path.join(home, ".claude"))  # a symlinked ~/.claude protects its target
    data = _resolve(data)
    plugin_root = os.environ.get("CLAUDE_PLUGIN_ROOT")
    plugin_root = _resolve(plugin_root) if plugin_root else None
    # the whole data root (state, lock files, keys); the agent controls this process's env, so also
    # every installed plugin's secrets by location
    deny_read = [_resolve(d) for d in deny_read + [data] + sandbox_exec.secret_dirs(data, home)]
    real_cwd = _resolve(cwd)
    project = os.environ.get("CLAUDE_PROJECT_DIR")
    if not project:
        print("harness-sandbox-exec: CLAUDE_PROJECT_DIR is not set; refusing to run", file=sys.stderr)
        return 2
    # allow-only: the cwd must be inside the workspace (the PreToolUse classifier is the primary
    # check and denies env/export changes to CLAUDE_PROJECT_DIR; this is defence in depth)
    real_project = _resolve(project)
    if not (real_cwd == real_project or real_cwd.startswith(real_project + os.sep)):
        print(f"harness-sandbox-exec: cwd {cwd!r} is outside the workspace; refusing to run", file=sys.stderr)
        return 2
    for bad in (claude_home, data, plugin_root):
        if bad and (real_cwd == bad or real_cwd.startswith(bad + os.sep)):
            print(f"harness-sandbox-exec: --cwd {cwd!r} is inside a protected tree; refusing to run", file=sys.stderr)
            return 2
    # every root below is fixed from the project root, never from the cwd
    protected = [os.path.join(real_project, n) for n in PROTECTED]
    allow_write = _job_dirs(real_project)
    if any(_under(real_cwd, p) for p in protected) and not any(_under(real_cwd, j) for j in allow_write):
        print(f"harness-sandbox-exec: --cwd {cwd!r} is inside a protected workspace path; refusing to run", file=sys.stderr)
        return 2
    # CLAUDE.md is protected at any depth: the cwd and its ancestors up to the project, plus existing nested ones
    # new nested CLAUDE*.md / .mcp.json at any depth are denied by a regex rule in sandbox_exec.profile
    d, nested = real_cwd, []
    while _under(d, real_project):
        nested += [os.path.join(d, "CLAUDE.md"), os.path.join(d, "CLAUDE.local.md")]
        d = os.path.dirname(d)
    nested += glob.glob(os.path.join(real_cwd, "**", "CLAUDE*.md"), recursive=True)
    deny_write = protected + nested
    deny_write += [_resolve(p) for p in deny_write]  # a symlinked CLAUDE.md protects its target too
    deny_write += [p for p in (data, plugin_root, claude_home) if p]
    stdin = None if sys.stdin is None or sys.stdin.isatty() else sys.stdin.buffer.read()
    code, out, err = sandbox_exec.run(cmd, real_cwd, stdin, timeout, deny_read, deny_write, allow_write)
    sys.stdout.buffer.write(out)
    sys.stderr.buffer.write(err)
    return code


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BaseException as e:  # fail closed, never run unsandboxed
        if isinstance(e, SystemExit):
            raise
        print(f"harness-sandbox-exec: {type(e).__name__}: {e}", file=sys.stderr)
        sys.exit(2)
