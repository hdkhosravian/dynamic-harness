#!/usr/bin/python3 -I
"""harness-answer header --unit UNIT --output SHA [--control-label TEXT]

Only prints a request; the PostToolUse writer renders the answer header (figure, metric and version, period,
source and data-up-to date, exclusions, rows, check status) from the recorded check output and the business
layer, and the gate includes it in the report."""
import json
import sys


def main(argv):
    if not argv or argv[0] != "header":
        print(__doc__, file=sys.stderr)
        return 2
    req, i = {"tool": "answer", "sub": "header"}, 1
    keys = {"--unit": "unit", "--output": "output", "--control-label": "control_label"}
    while i < len(argv):
        if argv[i] not in keys or i + 1 >= len(argv):
            print(__doc__, file=sys.stderr)
            return 2
        req[keys[argv[i]]] = argv[i + 1]
        i += 2
    print(json.dumps(req, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (OSError, ValueError) as e:
        print(f"harness-answer: {e}", file=sys.stderr)
        sys.exit(2)
