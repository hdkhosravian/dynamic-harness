{
  "description": "Dynamic harness safety hooks. /usr/bin/python3 -I (absolute: no PATH lookup, no user site-packages); hookmain watchdog = timeout - 1 s (gate/fetch: - 5 s); any handler failure exits 2; onFailure=block makes crashes/timeouts block (needs Claude Code >= 2.1.295, OQ-4 spike S1). PostToolUse records files written this session (sessions/<sid>/written.json).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"${CLAUDE_PLUGIN_ROOT}/bin/harness-hook\" PreToolUse",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"${CLAUDE_PLUGIN_ROOT}/bin/harness-hook\" PostToolUse",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"${CLAUDE_PLUGIN_ROOT}/bin/harness-hook\" SessionStart",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"${CLAUDE_PLUGIN_ROOT}/bin/harness-hook\" ConfigChange",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
