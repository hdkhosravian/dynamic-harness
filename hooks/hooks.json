{
  "description": "Dynamic harness safety hooks. /usr/bin/python3 -I (absolute: no PATH lookup, no user site-packages); hookmain watchdog = timeout - 1 s (gate/fetch: - 5 s); any handler failure exits 2; onFailure=block makes crashes/timeouts block (needs Claude Code >= 2.1.295, OQ-4 spike S1). Files written this session (sessions/<sid>/written.json): PreToolUse records Bash write targets before the command runs; PostToolUse and PostToolUseFailure record Write/Edit/MultiEdit/NotebookEdit. UserPromptSubmit records every turn, routes it (setup, contact reply, open task, inline T0, new) and runs the probe and pre-filter; /dynamic-harness:setup is blocked so the model never sees it. PreToolUse runs the pending-card gate, lanes, contacts, then safety. PostToolUse (every tool) runs written-file records, the writers and the tripwire. A second PostToolUse entry (matcher Bash, 1800 s) runs the gate on a lone harness-gate request and returns at once for any other command. SubagentStop records harness subagents and researcher claim rows. Stop verifies the receipt (never runs the gate), lints the final message and allows a stop only on a verified receipt, a stop record, a recorded contact or a clean quick answer; three identical blocks end the request as STOPPED_STALL.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"${CLAUDE_PLUGIN_ROOT}/bin/harness-hook\" PreToolUse",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"${CLAUDE_PLUGIN_ROOT}/bin/harness-hook\" PostToolUse",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"${CLAUDE_PLUGIN_ROOT}/bin/harness-hook\" PostToolUse --gate",
            "timeout": 1800,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"${CLAUDE_PLUGIN_ROOT}/bin/harness-hook\" PostToolUseFailure",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"${CLAUDE_PLUGIN_ROOT}/bin/harness-hook\" SessionStart",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"${CLAUDE_PLUGIN_ROOT}/bin/harness-hook\" ConfigChange",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"${CLAUDE_PLUGIN_ROOT}/bin/harness-hook\" UserPromptSubmit",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^dynamic-harness:[a-z0-9-]+$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"${CLAUDE_PLUGIN_ROOT}/bin/harness-hook\" SubagentStop",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^dynamic-harness:[a-z0-9-]+$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"${CLAUDE_PLUGIN_ROOT}/bin/harness-hook\" SubagentStart",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"${CLAUDE_PLUGIN_ROOT}/bin/harness-hook\" Stop",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
